# Streamlit secrets for Superliga Transfer Analytics app.
#
# For LOCAL development:
# 1. Copy this file to `.streamlit/secrets.toml` (it is git-ignored).
# 2. Fill in your database credentials below.
# 3. The app will read from `st.secrets` automatically.
#
# For STREAMLIT CLOUD deployment:
# 1. Go to your app dashboard on streamlit.cloud.
# 2. Click Settings → Secrets.
# 3. Paste ONE of the two forms below (your choice).
# 4. Replace YOUR-PASSWORD with your actual database password.
# 5. Save and reboot the app.

# ✅ RECOMMENDED for Streamlit Cloud: use the pooler URL
DATABASE_URL = "postgresql://postgres.dzmknrgbfudsxsmnffcu:FCDinamo1948!@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Alternative form if you prefer:
# TRANSFER_DB_URL = "postgresql://postgres.dzmknrgbfudsxsmnffcu:FCDinamo1948!@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Or nested form:
# [database]
# url = "postgresql://postgres.dzmknrgbfudsxsmnffcu:FCDinamo1948!@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Notes:
#   - The app checks DATABASE_URL, TRANSFER_DB_URL, DB_URL in that order.
#   - If none is found, it falls back to localhost (local dev only).
#   - For non-local hosts, the app automatically appends `?sslmode=require` if missing.
#   - Old-style `postgres://` URLs are accepted and normalized to `postgresql://`.
#   - Replace aws-0-eu-west-1 with your actual Supabase region if different.
#   - Replace postgres.dzmknrgbfudsxsmnffcu with your Supabase project credentials if different.
